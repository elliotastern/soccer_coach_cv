# Environment Variables Template
# Copy this file to .env and fill in your values
# Override these values in your .env file

# CVAT Configuration
CVAT_URL=http://localhost:8080
CVAT_USER=admin
CVAT_PASS=admin

# Model Configuration
# Local RF-DETR checkpoints used by apps/batch_pipeline.py (detection.backend=local_rfdetr)
PLAYER_CHECKPOINT=./models/people_after_100_epochs.pth
BALL_CHECKPOINT=./models/ball_89.pth
# Legacy single-path override (training / older scripts)
MODEL_PATH=./models/checkpoints/latest_checkpoint.pth

# Only required when configs set detection.backend=roboflow
# ROBOFLOW_API_KEY=

# Hugging Face (optional)
# Used by: DETR training (facebook/detr-resnet-50), goal detection (grounding-dino-base).
# Enables gated models and higher rate limits.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override config file paths
# WATCH_DIR=./incoming_videos
# PROCESSED_DIR=./processed
